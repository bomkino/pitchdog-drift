{
  "name": "pitchdog-drift",
  "private": true,
  "version": "0.4.0",
  "description": "An Apple-silicon Mac directing instrument for image and video slides.",
  "keywords": [
    "creative-tools",
    "local-first",
    "macos",
    "pitch-decks",
    "video-export",
    "metal",
    "native"
  ],
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@11.19.0",
  "homepage": "https://github.com/bomkino/pitchdog-drift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bomkino/pitchdog-drift.git"
  },
  "bugs": {
    "url": "https://github.com/bomkino/pitchdog-drift/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --mode v2-dev",
    "dev:v1": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "build:v2-dev": "tsc -b && vite build --mode v2-dev",
    "build:linux:tracer": "node scripts/build-linux-tracer.mjs",
    "verify:linux:tracer": "node scripts/verify-linux-tracer.mjs",
    "check:linux-source": "node scripts/check-linux-tracer-source.mjs",
    "check:fonts": "node scripts/verify-font-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:v2-dev": "npm run build:v2-dev && vite preview --host 127.0.0.1 --port 4174",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "setup:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "qa:atelier-atlas": "node scripts/capture-atelier-atlas.mjs",
    "qa:optical-atlas": "node scripts/capture-v2-optical-atlas.mjs",
    "qa:long-export": "node scripts/qa-long-export.mjs",
    "qa:long-export:full": "node scripts/qa-long-export.mjs --full",
    "qa:presenter-export": "playwright test --config=playwright.presenter-export.config.ts",
    "qa:presenter-export:smoke": "playwright test --config=playwright.presenter-export.config.ts --grep 'full presenter journey closes'",
    "check:mac-arm64": "node scripts/check-macos-arm64-contract.mjs",
    "check:mac-source": "node scripts/verify-macos-user-guide.mjs release docs/MACOS_USER_GUIDE.md && python3 scripts/test-native-release.py && bash -n scripts/build-native-app.sh scripts/package-native-app.sh scripts/package-macos-dmg.sh scripts/verify-macos-app.sh scripts/verify-macos-dmg.sh scripts/install-drift.sh",
    "build:mac:web": "node scripts/build-macos-web.mjs",
    "build:mac": "bash scripts/build-native-app.sh",
    "build:mac:v2-dev": "bash scripts/build-macos-v2-dev.sh",
    "verify:mac": "bash scripts/verify-macos-app.sh",
    "verify:mac:v2-dev": "bash scripts/verify-macos-v2-dev.sh",
    "package:mac:dmg": "bash scripts/package-macos-dmg.sh",
    "package:mac": "npm run package:mac:dmg",
    "verify:mac:dmg": "bash scripts/verify-macos-dmg.sh",
    "verify:mac-release": "bash scripts/verify-macos-release.sh",
    "release:mac": "bash scripts/release-macos-app.sh",
    "check": "npm run check:fonts && npm run typecheck && npm test && npm run check:release",
    "test:mac": "node scripts/generate-native-catalog.mjs && scripts/build-native-codecs.sh && scripts/build-native-archive.sh && xcrun swift test --package-path macos/NativeCore",
    "test:mac:app": "python3 scripts/run-native-ui-proof.py build/native-roundtrip/Drift.app",
    "check:release": "python3 scripts/test-native-release.py"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "1.55.1",
    "@phosphor-icons/react": "2.1.10",
    "fflate": "0.8.3",
    "mediabunny": "1.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
