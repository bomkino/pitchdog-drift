<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- WKWebView launches a system networking helper even for a signed local
       file document. The app still blocks HTTP(S), WebSocket and FTP inside
       WebKit, exposes no network bridge command, and ships no native client. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
